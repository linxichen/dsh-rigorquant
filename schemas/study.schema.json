{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/linxichen/dsh-rigorquant/schemas/study.schema.json",
  "title": "RigorQuant study.json",
  "description": "The study identity file created at intake (SKILL.md Step 1). Internal references recorded elsewhere in a study are study-root-relative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "mode",
    "repo_root",
    "statement",
    "success_criterion",
    "subproblems",
    "simplified_cases",
    "seeds",
    "tolerances",
    "budget",
    "status"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "kebab-case study id"
    },
    "title": { "type": "string" },
    "mode": {
      "enum": ["repo-root", "multi-study"],
      "description": "repo-root = one study per repo; multi-study = studies/<slug>/"
    },
    "repo_root": { "type": "string", "description": "absolute path resolved at intake" },
    "env_lane": { "type": "string", "description": "absolute path to the pinned uv lane, added by Step 2 (not at intake)" },
    "task_id": { "type": "string" },
    "created": { "type": "string" },
    "statement": { "type": "string" },
    "success_criterion": { "type": "string" },
    "subproblems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status", "success_criterion"],
        "properties": {
          "id": { "type": "string", "pattern": "^SP[0-9]+$" },
          "name": { "type": "string" },
          "status": { "enum": ["known", "novel"] },
          "success_criterion": { "type": "string" },
          "evidence_level": {
            "enum": [
              "falsification-surviving",
              "independently re-derived",
              "certificate-checked",
              "formally verified"
            ]
          }
        }
      }
    },
    "simplified_cases": { "type": "array", "items": { "type": "string" } },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_seed"],
      "properties": {
        "task_seed": { "type": "integer" },
        "convention": { "type": "string" }
      }
    },
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "stochastic"],
      "properties": {
        "deterministic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "abs": { "type": ["number", "string"] },
            "rel": { "type": ["number", "string"] }
          }
        },
        "stochastic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "se_units": { "type": "number" },
            "confidence": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "lln_grid": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_orchestrator_rounds": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": ["number", "null"] },
        "max_wall_minutes": { "type": ["number", "null"] }
      }
    },
    "status": { "type": "string" }
  }
}
