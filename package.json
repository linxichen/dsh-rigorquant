{
  "name": "dsh-rigorquant",
  "version": "0.4.0",
  "description": "RigorQuant for DeepSeek Harness: session-scoped unattended, context-isolated multi-agent research for empirical/computational mathematics with a four-part pre-implementation check battery and a jacobian/Lean escalation lane.",
  "license": "MIT",
  "bin": {
    "dsh-rigorquant": "./install.sh"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quant",
    "research"
  ],
  "type": "module",
  "files": [
    "cordis.patch.yml",
    "dsh/",
    "agent-presets/",
    "env/",
    "mcp/",
    "docs/",
    "tests/",
    "install.sh",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./sync": "./dsh/sync.js",
    "./activity": "./dsh/activity.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  }
}
